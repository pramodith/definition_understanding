# Example environment variables for Definition Understanding
# Copy this file to .env and fill in the values as needed

# OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Together API key
TOGETHER_API_KEY=your_together_api_key_here

# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Dictionary API key
DICTIONARY_API_KEY=your_dictionary_api_key_here

# HuggingFace API token for model access (if required)
HF_TOKEN=your_huggingface_token_here

# LiteLLM log level (optional, default: WARNING)
LITELLM_LOG=WARNING

GEMINI_API_KEY=your_gemini_api_key_here